{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hartat-site",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "API_URL": "https://hartat-api.luispassoca.workers.dev"
  },
  "services": [
    {
      "binding": "API",
      "service": "hartat-api"
    }
  ]
}
